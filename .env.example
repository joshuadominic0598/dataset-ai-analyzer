# Export these in your shell before starting Reviso. .env is NOT loaded automatically.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
# Local inference. The app defaults to qwen3:8b; only loopback addresses are allowed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Optional text search. Choose the provider and model in Dataset setup.
# Ollama, OpenAI, and Gemini are supported; Groq chat can use any separately.
